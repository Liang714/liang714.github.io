{
  "name": "liang-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Personal AI engineer portfolio: static React + TypeScript site deployed to GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/postbuild.mjs",
    "build:subpath": "BASE_PATH=/portfolio-check/ npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "content:check": "node scripts/check-placeholders.mjs",
    "assets": "node scripts/make-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "^5.3.0",
    "@fontsource-variable/overpass-mono": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lenis": "^1.3.27",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
