  "narrative": {
    "northStar": "The Name on the Gate",
    "overview": "The name is the loudest thing on the page, and the owner's own safety gate is the picture. The first screen holds a doorway-shaped gate with small requests drifting toward it, and one of them is always about to be allowed, denied or held for a person. Under it, the name LIANG is fitted to the full width of the screen. After that the page goes calm.\n\nThe system is graphite with two other grounds (one cobalt field for the stack, one pale field for the record and the footer) and one loud colour, safety orange, which marks the single action on a screen and whatever the gate stopped. Everything is set in one family, Chivo. Depth is a step in tone. State is a shape beside a word.",
    "keyCharacteristics": [
      "One monumental word per screen; everything else is small and calm.",
      "Flat tonal layers: graphite, raised graphite, lifted graphite. No shadows, no gradients, no hairlines.",
      "One accent, safety orange, with one job: the action, and the thing that was stopped.",
      "Colour never carries a state alone; every state has a shape and a word.",
      "Square corners everywhere except one round mail button.",
      "Motion is rare and authored: the name rises once, the gate demo moves, lines light as they cross the middle."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Safety orange appears on the single action of a screen and on a denied request. It never decorates, never appears twice as an action, and never fills a section.",
        "section": "colors"
      },
      {
        "name": "The Shape Beside Colour Rule",
        "body": "Orange, blue and ink marks always travel with a word (Denied, Held, Valid) and a shape (filled square, ring, dash). A state that only changes colour is a bug.",
        "section": "colors"
      },
      {
        "name": "The Two Ends Rule",
        "body": "The page uses enormous type and small type and little between. A headline is never set at an in-between size to \"fit\".",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Capitals belong to the black display weight only. Labels, buttons and notes are sentence case, never tracked-out capitals.",
        "section": "typography"
      },
      {
        "name": "The No Edge Lines Rule",
        "body": "If two things need separating, give them space or a different tone. A 1px line is never the answer.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do let one word per screen be enormous and keep everything else small.",
      "Do put the result and its limit side by side, and label every simulation and example as one.",
      "Do pair every colour state with a shape and a word.",
      "Do use only graphite, cobalt and paper as grounds, and safety orange for one action per screen.",
      "Do keep reading text to 38em and at 17px or larger.",
      "Do give every motion a reduced-motion version that keeps the content."
    ],
    "donts": [
      "Don't add hairlines, shadows, gradients, glows, glass, or rounded cards.",
      "Don't set labels in capitals, letter-spaced, or in monospace; code is the only monospace.",
      "Don't number sections or put a small label above a heading.",
      "Don't fill a section with orange or use it for decoration.",
      "Don't add a second typeface, a portrait or a screenshot the owner has not supplied, or any claim, number or customer that is not in the repositories.",
      "Don't animate anything with layout properties; transform and opacity only."
    ]
  }
}
