      "css": ".ds-lane{position:relative;display:flex;align-items:flex-end;gap:14px;height:150px;padding:0 0 10px;border-bottom:10px solid #2e3135}.ds-gate-frame{position:relative;width:112px;height:150px;flex:none;order:2}.ds-gate-frame i{position:absolute;bottom:0;width:16px;height:100%;background:#eff0f1}.ds-gate-frame i:first-child{left:0}.ds-gate-frame i:nth-child(2){right:0}.ds-gate-frame b{position:absolute;inset:0 0 auto;height:16px;background:#eff0f1}.ds-tok{display:flex;align-items:center;gap:12px;height:48px;padding:0 18px;background:#eff0f1;color:#17181a;font:700 .85rem \"Chivo Variable\",Arial,sans-serif;white-space:nowrap}.ds-tok em{font-style:normal;font-weight:500;opacity:.85}.ds-tok--ask{background:#8da7ff}.ds-tok--deny{background:#ff4a1f}"
    },
